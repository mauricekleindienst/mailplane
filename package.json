{
  "name": "mailplane",
  "productName": "Mailplane",
  "version": "1.0.0",
  "description": "A beautiful mail client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg",
    "build:icons": "node scripts/build-icons.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,css,html}\" --ignore-path .prettierignore",
    "test": "node --test test/**/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:linux": "xvfb-run -a playwright test",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@sentry/electron": "^7.13.0",
    "better-sqlite3": "^12.10.0",
    "electron": "^30.5.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "imapflow": "^1.3.3",
    "mailparser": "^3.9.8",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.63.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.1",
    "prettier": "^3.8.3"
  },
  "build": {
    "appId": "com.mailplane.app",
    "productName": "Mailplane",
    "copyright": "© 2026 Mailplane",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "theme.css",
      "assets/**",
      "src/**",
      "node_modules/**",
      "!node_modules/.cache",
      "!dist/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Mailplane",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "mauricekleindienst",
      "repo": "mailplane",
      "releaseType": "release"
    }
  }
}
