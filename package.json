{
  "name": "mailplane",
  "productName": "Mailplane",
  "version": "0.2.0",
  "description": "A calm, fast email client for macOS, Windows, Linux and Android",
  "author": {
    "name": "Mailplane",
    "url": "https://github.com/mauricekleindienst/mailplane"
  },
  "homepage": "https://github.com/mauricekleindienst/mailplane",
  "repository": {
    "type": "git",
    "url": "https://github.com/mauricekleindienst/mailplane.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg",
    "build:icons": "node scripts/build-icons.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,css,html}\" --ignore-path .prettierignore",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:linux": "xvfb-run -a playwright test",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "screenshots": "playwright test --config scripts/screenshots.config.js"
  },
  "dependencies": {
    "@sentry/electron": "^7.13.0",
    "better-sqlite3": "^12.10.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "imapflow": "^1.3.3",
    "mailparser": "^3.9.8",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.63.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.1",
    "prettier": "^3.8.3"
  },
  "build": {
    "appId": "com.mailplane.app",
    "productName": "Mailplane",
    "protocols": [
      {
        "name": "Email",
        "schemes": [
          "mailto"
        ]
      }
    ],
    "copyright": "© 2026 Mailplane",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "theme.css",
      "assets/**",
      "src/**",
      "node_modules/**",
      "!node_modules/.cache",
      "!dist/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Mailplane",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-windows-setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "mauricekleindienst",
      "repo": "mailplane",
      "releaseType": "draft"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Network;Email",
      "maintainer": "Mailplane <mailplane@users.noreply.github.com>",
      "synopsis": "Calm, fast email",
      "mimeTypes": [
        "x-scheme-handler/mailto"
      ]
    },
    "deb": {
      "artifactName": "${productName}-${version}-linux-amd64.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-linux-x64.${ext}"
    }
  }
}
