{
  "name": "mailplane",
  "productName": "Mailplane",
  "version": "1.0.0",
  "description": "A beautiful mail client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg"
  },
  "dependencies": {
    "@sentry/electron": "^7.13.0",
    "electron": "^30.5.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "imapflow": "^1.3.3",
    "mailparser": "^3.9.8",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mailplane.app",
    "productName": "Mailplane",
    "copyright": "© 2026 Mailplane",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "assets/**",
      "src/**",
      "node_modules/**",
      "!node_modules/.cache",
      "!dist/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Mailplane",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
